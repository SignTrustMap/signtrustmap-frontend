# ── Unified API Gateway (Single Entry Point) ──────────────────────────
# Set to https://api.signmap.site for production cloud
# Or set to http://10.0.2.2:8080 when connecting to local Docker Nginx Gateway
EXPO_PUBLIC_GATEWAY_URL=https://api.signmap.site

# ── Dedicated Service Endpoints (Optional; fallback to Gateway paths) ─
EXPO_PUBLIC_API_URL=https://api.signmap.site/api/v1
EXPO_PUBLIC_STORAGE_URL=https://s3.signmap.site
EXPO_PUBLIC_S3_URL=https://s3.signmap.site
EXPO_PUBLIC_CDN_URL=https://s3.signmap.site
EXPO_PUBLIC_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}

# ── Google OAuth2 Authentication ─────────────────────────────────────
# Web Client ID (Google Cloud Console OAuth 2.0 Web Client)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Android Client ID (optional, if using standalone Android build)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS Client ID (optional, if using standalone iOS build)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
