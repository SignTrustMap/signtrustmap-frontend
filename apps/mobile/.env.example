# Optional during local development; the app derives the API host from Metro.
# Set this for deployed builds.
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1

# Optional. Defaults to Esri's global street basemap.
EXPO_PUBLIC_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
