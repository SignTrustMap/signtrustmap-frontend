{
  "name": "signtrustmap-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "lint:web": "npm run lint --workspace=web",
    "dev:mobile": "npm run start --workspace=mobile",
    "android:mobile": "npm run android --workspace=mobile",
    "ios:mobile": "npm run ios --workspace=mobile",
    "web:mobile": "npm run web --workspace=mobile",
    "lint:mobile": "npm run lint --workspace=mobile",
    "typecheck:mobile": "npm run typecheck --workspace=mobile",
    "doctor:mobile": "cd apps/mobile && npx expo-doctor",
    "ci": "npm run lint:web && npm run build:web && npm run lint:mobile && npm run typecheck:mobile"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SignTrustMap/signtrustmap-frontend.git"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SignTrustMap/signtrustmap-frontend/issues"
  },
  "homepage": "https://github.com/SignTrustMap/signtrustmap-frontend#readme",
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "expo-gl": "~57.0.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4"
  }
}
