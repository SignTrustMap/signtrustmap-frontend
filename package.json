{
  "name": "signtrustmap-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "lint:web": "npm run lint --workspace=web",
    "dev:ops": "npm run dev --workspace=ops",
    "build:ops": "npm run build --workspace=ops",
    "lint:ops": "npm run lint --workspace=ops",
    "dev:mobile": "npm run start --workspace=mobile",
    "android:mobile": "npm run android --workspace=mobile",
    "ios:mobile": "npm run ios --workspace=mobile",
    "web:mobile": "npm run web --workspace=mobile",
    "lint:mobile": "npm run lint --workspace=mobile",
    "typecheck:mobile": "npm run typecheck --workspace=mobile",
    "doctor:mobile": "cd apps/mobile && npx expo-doctor",
    "build:apk:mobile": "cd apps/mobile/android && gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "build:apk:debug": "cd apps/mobile/android && gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "ci": "npm run lint:web && npm run build:web && npm run lint:ops && npm run build:ops && npm run lint:mobile && npm run typecheck:mobile",
    "test": "jest --watchAll",
    "test:ci": "jest --watchAll=false",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:integration": "jest apps/mobile/__tests__/intergration --watchAll=false",
    "test:unit": "jest apps/mobile/__tests__/unit/upload apps/mobile/__tests__/unit/navigation apps/mobile/__tests__/unit/review apps/mobile/__tests__/unit/profile apps/mobile/__tests__/unit/ui --watchAll=false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SignTrustMap/signtrustmap-frontend.git"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SignTrustMap/signtrustmap-frontend/issues"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "<rootDir>/jest.environment.js",
    "setupFiles": ["<rootDir>/jest.setup.js"],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx|mjs)$": "babel-jest",
      "^.+\\.(bmp|gif|jpg|jpeg|mp4|png|psd|svg|webp)$": "<rootDir>/node_modules/@react-native/jest-preset/jest/assetFileTransformer.js"
    },

    "transformIgnorePatterns": [
      "node_modules[\\\\/](?!.*(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|msw|@msw|@mswjs|rettime|outvariant|until-async|@open-draft|is-node-process|cookie))",
      "[\\\\/]node_modules[\\\\/]react-native-reanimated[\\\\/]plugin[\\\\/]",
      "[\\\\/]node_modules[\\\\/]@react-native[\\\\/]babel-preset[\\\\/]"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/__mocks__/styleMock.js",
      "^@/assets/(.*)$": "<rootDir>/apps/mobile/assets/$1",
      "^@/(.*)$": "<rootDir>/apps/mobile/src/$1"
    }
  },
  "homepage": "https://github.com/SignTrustMap/signtrustmap-frontend#readme",
  "devDependencies": {
    "@types/jest": "29.5.14",
    "eslint-plugin-testing-library": "^7.16.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5"
  },
  "overrides": {
    "@react-native/jest-preset": "^0.86.3"
  }
}
